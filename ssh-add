#!/bin/sh

# Basically, reimplements https://unix.stackexchange.com/a/560404
# Before this can work, you need to run this command just once:
# ssh-add --apple-use-keychain /path/to/your/private_key
#
# Sourced by loginhook at login time, when the user's keychain
# may not yet be unlocked. Background a retry loop so the
# loginhook isn't blocked, and keep polling until ssh-add
# reports an identity loaded (or we give up).

(
    n=0
    max=30
    while [ "$n" -lt "$max" ]; do
        out=$(ssh-add --apple-load-keychain 2>&1)
        printf '%s\n' "$out"
        case $out in
            *'Identity added'*) exit 0 ;;
        esac
        n=$((n + 1))
        sleep 2
    done
    echo "ssh-add: no identity loaded after $n attempts" >&2
    exit 1
) &
