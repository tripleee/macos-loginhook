#!/bin/sh

# Basically, reimplements https://unix.stackexchange.com/a/560404
# Before this can work, you need to run this command just once:
# ssh-add --apple-use-keychain /path/to/your/private_key
#
# Run by session-daemon (~/.session.d/), since the keychain may
# still be locked for a while after login. Retry loading keys
# until an identity is added, then block so session-daemon
# leaves us alone; giving up after a round of attempts makes us
# exit, so session-daemon restarts us for another round in 30s.

n=0
max=30
while [ "$n" -lt "$max" ]; do
    out=$(ssh-add --apple-load-keychain 2>&1)
    [ -n "$out" ] && printf '%s\n' "$out"
    case $out in
        *'Identity added'*) exec sleep infinity ;;
    esac
    n=$((n + 1))
    sleep 2
done
echo "ssh-add: no identity loaded after $n attempts, giving up" >&2
exit 1
